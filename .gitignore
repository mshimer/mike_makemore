# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Dot Env
# NOTE: ".env/" with a trailing slash only matches a DIRECTORY named .env -
# it does NOT ignore a .env *file*. These patterns cover both.
.env
.env.*
!.env.example
.env/

.DS_Store